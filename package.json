{
  "name": "coherence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Coherence — a local-first map of your goals, the conflicts between them, and the experiments that test them.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "audit:prohibitions": "node scripts/prohibitions.mjs",
    "verify": "npm run test && npm run build && npm run audit:prohibitions",
    "e2e": "node e2e/shortform.mjs && node e2e/standing-view.mjs && node e2e/lifebook.mjs && node e2e/evidence-loop.mjs && node e2e/return-loop.mjs && node e2e/acceptance.mjs && node e2e/release-and-carry.mjs && node e2e/map-density.mjs && node e2e/offline-and-print.mjs",
    "build:account": "vite build --outDir dist-account",
    "preview:account": "vite preview --outDir dist-account --port 4174",
    "e2e:accounts": "node e2e/accounts.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@fontsource/ibm-plex-sans": "^5.1.1",
    "@supabase/supabase-js": "^2.112.4",
    "d3-force": "^3.0.0",
    "dexie": "^4.0.10",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
