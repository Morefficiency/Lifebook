# Accounts. Leave both blank to run the app entirely locally, with no sign-in
# screen and nothing synced — which is how it behaves with no file here at all.
#
# Both values are public by design: the anon key ships in the browser bundle and
# every table it can reach is protected by row-level security. It grants nothing
# beyond "act as whoever is signed in". The service_role key must never appear
# in this file or anywhere else in this repository.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to false to hide the Google button (e.g. before you have configured the
# Google provider in Supabase → Authentication → Providers).
VITE_ENABLE_GOOGLE=true

# ---------------------------------------------------------------- selling ---
# Who a customer is contracting with. These appear in the privacy policy, the
# terms and the refund policy, so they must be true and they must be filled in
# before you take a payment — `npm run check:launch` fails while any is blank.
#
# OPERATOR_NAME  the legal name of whoever receives the money; your own name is
#                fine for a sole trader
# GOVERNING_LAW  the country or state whose law the terms run under, e.g. France
# POLICY_UPDATED the date the current policies took effect, e.g. 2 September 2026
# The origin the app is deployed to, e.g. https://lifebook.example.com — with no
# trailing slash. Used for the Open Graph image, the canonical link and the
# checkout return URL. Leave it blank and the share tags are dropped rather than
# shipped pointing at a placeholder, so a link posted anywhere previews as a
# bare grey URL. Set it before you share the link with anybody.
VITE_APP_URL=

VITE_OPERATOR_NAME=
VITE_SUPPORT_EMAIL=
VITE_GOVERNING_LAW=
VITE_POLICY_UPDATED=

# Stripe lives entirely on the server side. The secret key, the price id and the
# webhook secret are set on the Supabase Edge Functions, never here:
#   supabase secrets set STRIPE_SECRET_KEY=sk_... STRIPE_PRICE_ID=price_... \
#     STRIPE_WEBHOOK_SECRET=whsec_... APP_URL=https://your-deployed-url
# Nothing Stripe-related belongs in a VITE_ variable, because VITE_ means public.
